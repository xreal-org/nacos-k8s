{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "nacos": {
      "type": "object",
      "properties": {
        "auth": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "null inherits the Nacos image default; true and false are explicit overrides"
            },
            "existingSecret": {
              "type": "string"
            },
            "tokenSecretKey": {
              "type": "string",
              "minLength": 1
            },
            "identityKeySecretKey": {
              "type": "string",
              "minLength": 1
            },
            "identityValueSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "oidc": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable OIDC/OAuth2 authentication (Nacos >= 3.2.0); renders an application.properties override and mounts it into the container"
            },
            "issuerUri": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            },
            "scope": {
              "type": "string"
            },
            "usernameClaim": {
              "type": "string"
            },
            "rolesClaim": {
              "type": "string"
            },
            "adminRole": {
              "type": "string"
            },
            "audience": {
              "type": "string",
              "description": "Optional audience (API identifier) sent on authorize/token requests; requires the patched nacos-oidc-auth-plugin jar"
            },
            "endSessionEndpoint": {
              "type": "string",
              "description": "Optional end-session endpoint override for IdPs that don't expose end_session_endpoint in discovery (e.g. Auth0); requires the patched nacos-oidc-auth-plugin jar"
            }
          }
        },
        "authToken": {
          "type": "string"
        },
        "identityKey": {
          "type": "string"
        },
        "identityValue": {
          "type": "string"
        },
        "storage": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "db": {
              "type": "object",
              "properties": {
                "host": { "type": "string" },
                "name": { "type": "string" },
                "port": { "type": "integer" },
                "username": { "type": "string" },
                "password": {
                  "type": ["string", "object"],
                  "description": "Plain text password (legacy), or an object referencing a K8s Secret",
                  "properties": {
                    "existingSecret": {
                      "type": "string",
                      "description": "K8s Secret holding the MySQL password; when set, mysql.password is not rendered into nacos-cm and the password is injected from the Secret"
                    },
                    "key": {
                      "type": "string",
                      "description": "Key inside existingSecret that holds the MySQL password (default: password)"
                    }
                  },
                  "required": ["existingSecret"]
                },
                "param": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
